  "events": [{"name": "绍兴和议", "text": "绍兴和议：宋向金称臣，以淮水、大散关为界|Peace of Shaoxing: Song submits to Jin, the border set at the Huai and Dasan Pass|紹興和議：宋向金稱臣，以淮水、大散關爲界", "after": 1, "when": [{"kind": "holds_city", "a": "jin", "city": "kaifeng"}, {"kind": "at_war", "a": "jin", "b": "song"}], "then": [{"kind": "cede", "a": "song", "b": "jin", "city": "nanyang"}, {"kind": "relation", "a": "song", "b": "jin", "relation": "truce"}, {"kind": "relation", "a": "song", "b": "jin", "relation": "tribute"}]}, {"name": "卡特万之战", "text": "西辽大败塞尔柱于卡特万|Qara Khitai crushes the Seljuks at Qatwan|西遼大敗塞爾柱於卡特萬", "after": 1, "when": [{"kind": "alive", "a": "qara_khitai"}, {"kind": "alive", "a": "great_seljuk"}], "then": [{"kind": "relation", "a": "qara_khitai", "b": "great_seljuk", "relation": "war", "goal": "夺城"}, {"kind": "relation", "a": "west_karakhanid", "b": "qara_khitai", "relation": "tribute"}]}, {"name": "岳飞之死", "text": "大将岳飞下狱被杀，天下冤之|The great general Yue Fei is imprisoned and put to death; the realm mourns the injustice|大將岳飛下獄被殺，天下冤之", "after": 2, "when": [{"kind": "holds_city", "a": "jin", "city": "kaifeng"}], "then": [{"kind": "dies", "a": "song", "person": "岳云、张宪、岳飞", "name": "以莫须有之罪被杀|put to death on a fabricated charge|以莫須有之罪被殺"}]}, {"name": "埃德萨陷落", "text": "赞吉攻陷埃德萨|Zengi takes Edessa|贊吉攻陷埃德薩", "after": 4, "when": [{"kind": "holds_city", "a": "edessa_county", "city": "edessa"}, {"kind": "alive", "a": "zengid"}], "then": [{"kind": "cede", "a": "edessa_county", "b": "zengid", "city": "edessa"}]}, {"name": "穆瓦希德起兵", "text": "穆瓦希德自阿特拉斯山起兵，夺取非斯|The Almohads rise out of the Atlas and take Fez|穆瓦希德自阿特拉斯山起兵，奪取非斯", "after": 5, "when": [{"kind": "holds_city", "a": "almoravid", "city": "fez"}], "then": [{"kind": "rebel", "a": "almoravid", "b": "almohad", "city": "fez", "cities": ["sijilmasa", "tingis"], "name": "穆瓦希德|Almohad|穆瓦希德", "person": "阿卜杜勒·穆明"}]}, {"name": "第二次十字军东征", "text": "教宗号召十字军东征，法兰西与神圣罗马出兵|The pope calls a crusade; France and the Empire march east|教宗號召十字軍東征，法蘭西與神聖羅馬出兵", "