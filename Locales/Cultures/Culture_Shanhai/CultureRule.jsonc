{
    "name": "Shanhai",
    "color": "#2E8B57",
    "translate_cz": "山海经",
    "setting": {
        "regime": "ZhouFeudalism",
        "institution_line": "Huaxia",
        // 天下标识：同一标识的文化同属一个天下(相邻的帝国法理自动并成一个天下)；留空 = 本文化自成一个天下
        "tianxia": "Huaxia",
        // 开局阶段：写华夏线的一个制度节点(如 "huaxia_patriarchal_clan" 从宗法开局)，留空从原始群起步
        "start_institution": "",
        // 姓氏演变：原始群无姓 → 母系有姓 → 贵族分氏 → 周制男子称氏、女子称姓、平民无氏 → 郡县后姓氏合一
        "surname_evolution": true,
        // 宪法：名称词库(name_group / provisional_name_group)与本文化的制宪倾向(clauses，覆盖各党主张)
        "Constitution": {
            "clauses": { "territory": "Unitary" }
        },
        // 强统一诉求：启用军阀时期的唯一中央、易帜归附、临时政府与统一继承机制(同华夏；以前漏配，近代按西方规则走。
        // 用户 2026-10-21 选补上)
        "political_traits": ["strong_unification"],
        // 未组建政府的现代势力称呼沿用华夏的中国近代史称呼("文化:词库名"引用别的文化的词库)
        "Party": {
            "untitled_groups": {
                "Anarchism": "Huaxia:UntitledAnarchism",
                "SocialDemocracy": "Huaxia:UntitledSocialDemocracy",
                "Libertarianism": "Huaxia:UntitledLibertarianism",
                "SocialLiberalism": "Huaxia:UntitledSocialLiberalism",
                "Capitalism": "Huaxia:UntitledWarlord",
                "ConservativeLiberalism": "Huaxia:UntitledWarlord",
                "Centrism": "Huaxia:UntitledWarlord",
                "Socialism": "Huaxia:UntitledSocialism",
                "Communism": "Huaxia:UntitledCommunism",
                "ReligiousDemocracy": "Huaxia:UntitledReligiousDemocracy",
                "Authoritarianism": "Huaxia:UntitledAuthoritarianism",
                "Conservatism": "Huaxia:UntitledWarlord",
                "Fascism": "Huaxia:UntitledFascism"
            }
        },
        "traits": ["patriarchy"],
        // 村镇命名(见 Locales/Cultures/README.md 村镇一节)：姓氏(罗家庄)、地势(青石山村)、字库(桃花村)的分量与词库
        "Settlement": {
            "village_modes": { "surname": 3, "terrain": 2, "words": 1 },
            "town_modes": { "terrain": 1, "words": 2 },
            "fort_modes": { "terrain": 1, "words": 1 },
            "village_words": "Huaxia:VillageWords",
            "village_suffix": "Huaxia:VillageSuffix",
            "surname_suffix": "Huaxia:SurnameSuffix",
            "town_words": "Huaxia:TownWords",
            "town_suffix": "Huaxia:TownSuffix",
            "fort_words": "Huaxia:TownWords",
            "fort_suffix": "Huaxia:FortSuffix",
            "terrain_prefix": "Huaxia:TerrainPrefix",
            "terrain_suffix": "Huaxia:TerrainSuffix",
            "terrain": { "mountain": "Huaxia:TerrainMountain", "hill": "Huaxia:TerrainHill", "water": "Huaxia:TerrainWater", "coast": "Huaxia:TerrainCoast", "forest": "Huaxia:TerrainForest", "plain": "Huaxia:TerrainPlain", "desert": "Huaxia:TerrainDesert", "swamp": "Huaxia:TerrainSwamp" }
        },
        "City": {
            "groups": {
                "group_1": "CityNames"
            },
            "rule": [ "group_1" ],
            "name_pos": 0
        },
        "Clan": {
            "groups": {
                "group_1": "ClanNames",
                "group_2": "Clan",
                "group_3": "\u200A"
            },
            "rule": [ "group_1", "group_3", "group_2" ],
            "name_pos": 0,
            "has_sex_post": false,
            "use_local_as_lastname": false,
            "sex_post_Male": ["", "", ""],
            "sex_post_Female": ["", "", ""]
        },
        "Family": {
            "groups": {
                "group_1": "FamilyNames",
                "group_2": "Family",
                "group_3": "\u200A"
            },
            "rule": [ "group_1", "group_3", "group_2" ],
            "name_pos": 0,
            "has_sex_post": false,
            "use_local_as_lastname": false
        },
        "Unit": {
            "groups": {
                "group_1": "UnitNamesTiangan",
                "group_2": "UnitNamesDizhi",
                "group_3": "UnitNamesQianziwen"
            },
            "rule": [
                "group_3",
                "group_1",
                "divider",
                "group_2",
                "group_3"
            ],
            "name_pos": 1,
            "is_invert": false
        },
        "Kingdom": {
            "groups": {
                "group_1": "CountryNames"
            },
            "rule": [ "group_1" ],
            "name_pos": 0
        }
    },
    "beaurau_config": {
        "CoreOffice": [],
        "Divisions": []
    }
}
