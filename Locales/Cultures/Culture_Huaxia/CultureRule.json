{
    "name": "Huaxia",
    "color": "#D4AF37",
    "translate_cz": "华夏",
    "setting": {
        "regime": "LvLing",
        "institution_line": "Huaxia",
        // 政党命名词库：理念 → 词库名，对应 Locales/Cultures/Culture_Huaxia/Huaxia<词库名>.csv
        // 理念可选：Anarchism, SocialDemocracy, Libertarianism, SocialLiberalism, Capitalism, ConservativeLiberalism, Centrism, Socialism, Communism, ReligiousDemocracy, Authoritarianism, Conservatism, Fascism
        // 没配的理念会用 Locales/Cultures/PartyNames/Party<理念>.csv 的通用党名
        "Party": {
            "groups": {
                "Anarchism": "PartyAnarchism",
                "SocialDemocracy": "PartySocialDemocracy",
                "Libertarianism": "PartyLibertarianism",
                "SocialLiberalism": "PartySocialLiberalism",
                "Capitalism": "PartyCapitalism",
                "ConservativeLiberalism": "PartyConservativeLiberalism",
                "Centrism": "PartyCentrism",
                "Socialism": "PartySocialism",
                "Communism": "PartyCommunism",
                "ReligiousDemocracy": "PartyReligiousDemocracy",
                "Authoritarianism": "PartyAuthoritarianism",
                "Conservatism": "PartyConservatism",
                "Fascism": "PartyFascism"
            },
            // 改制共和后的国号后缀词库：理念 → 词库名(规则同上)；没配的理念用 Locales/Cultures/PartyNames/Suffix<理念>.csv
            "suffix_groups": {}
        },
        "traits": ["patriarchy"],
        "City": {
            "groups": {
                "group_1": "CityNames1",
                "group_2": "CityNames2"
                //这里的group后面的名称可以随意制定，
                // 但是需要在对应文化的文件夹中创建同名的.csv文件且带上文化前缀，比如这里的group_1绑定的是叫做CityNames1的词库
                //如果我的文化是Huaxia，那么就应该在Cultures/Culture_Huaxia/的目录下创建一个名为HuaxiaCityNames1.csv的文件，并且写入对应词库
            },
            "rule": [ "group_1", "group_2" ], // 此处为字库组的组合规则
            "name_pos": 0
            //这里的name_pos代表了名字的位置，比如常见的城市名称组合为XX市，
            // 其中XX就是它的名字，人物姓名也是如此，王XX，XX就是他的名字
            //而在此模组中一般是利用空格来区分姓与名，或者城市后缀，因此name_pos就用来指定全称的哪一部分为他的有效名称，
            // 比如模组中常见的XX 市，在这个组合下，name_pos就是0，
            // 如果有特殊的名称比如“钢铁 德莱尔”，这里德莱尔为有效名称，name_pos就应该是1，
            //另外，上面的组合规则也相应的设置好，比如一个城市的命名规则中是由两个有效名称词库的随机组合加一个随机后缀组成那么
            // 规则就应该是 ["group_1", "group_2", "space", "group_3"] 最终显示的效果就是: xx x。 //
        },
        "Clan": {
            "groups": {
                "group_1": "ClanNames",
                "group_2": "\u200A",
                "group_3": "Clan"
            },
            "rule": [ "group_1", "group_2", "group_3" ],
            "name_pos": 0,
            "has_sex_post": false, //是否存在姓名后缀，有些文化的姓氏存在阴阳词性，在这里设置为true，并且在Locales/Cultures/NameSexPost.csv中配置好后，人物的姓名就会显示词性
            "use_local_as_lastname": false, //是否将名称放在前面，姓氏放在后面。
            //名称性别后缀从左往右分别是: 中(简), 英, 中(繁),
            "sex_post_Male": ["", "", ""], //男性后缀
            "sex_post_Female": ["", "", ""] //女性后缀
        },
        "Family": {
            "groups": {
                "group_1": "FamilyNames",
                "group_2": "\u200A",
                "group_3": "Family"
            },
            "rule": [ "group_1", "group_2", "group_3" ],
            "name_pos": 0,
            "has_sex_post": false, // 同上
            "use_local_as_lastname": false
        },
        "Unit": {
            "groups": {
                "group_1": "UnitNamesMale1",
                "group_2": "UnitNamesMale2",
                "group_3": "UnitNamesFemale1",
                "group_4": "UnitNamesFemale2"
            },
            "rule": [
                "group_1",
                "sex_male",
                "coin_flip",
                "group_2",
                "sex_male",
                "group_3",
                "sex_female",
                "coin_flip",
                "group_4",
                "sex_female"
                //这里的规则词条与游戏中的文化模板里面提供的是一致的，参考文化模板的规则即可，
                // 但是词条需要使用Scripts/Enums/OnomasticsType.cs中提供的，当然也可以自己添加，
                // 前提是需要和游戏源代码里面使用的一致，而不是游戏里面显示的，其他的词条作者还没有补全，
                // 只添加了几个常用的，比如sex_male,sex_female的性别过滤器和coin_flip概率发生器等。
            ],
            "name_pos": 1,
            "is_invert": false
        },
        "Kingdom": {
            "groups": {
                "group_1": "CountryNames"
            },
            "rule": [ "group_1" ],
            "name_pos": 0,
            // 英文界面是否使用 The {国家类别} of {国名}；false 为 {国名} {国家类别}
            "english_type_prefix": false
        }
    }
}
