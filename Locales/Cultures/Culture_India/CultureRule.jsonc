{
    "name": "India",
    "color": "#FF9933",
    "translate_cz": "印度",
    "setting": {
        "regime": "Origin",
        "institution_line": "Arabic",
        // 天下标识(用户 2026-10-21 定"补天下标识")：本文化自成一个天下；明写了，相邻的同文化帝国法理才会自动并成一个天下
        // (没写的一个帝国法理一个天下，常常凑不满 8 城、没有天命，见 TianxiaSystem.AutoArrange)
        "tianxia": "India",
        // 宪法：名称词库(name_group / provisional_name_group)与本文化的制宪倾向(clauses，覆盖各党主张)
        "Constitution": {
            "clauses": { "territory": "Federal" }
        },
        // 现代政权称呼(见 Locales/Cultures/README.md 政党一节)：未组建政府的势力 / 临时政府；没配的理念用默认称呼
        "Party": {
            "untitled_groups": {
                "Centrism": "UntitledCentrism",
                "Communism": "UntitledCommunism",
                "ReligiousDemocracy": "UntitledReligiousDemocracy",
                "Authoritarianism": "UntitledAuthoritarianism"
            }
        },
        "traits": ["patriarchy"],
        // 法教传统：不发起圣战，宗教向来宽容(见 PapacySystem.DharmicTrait、ReligiousTension)
        "political_traits": ["dharmic"],
