{
    "name": "Youmu",
    "color": "#B08968",
    "translate_cz": "游牧",
    "setting": {
        "regime": "YouMu",
        "institution_line": "Youmu",
        "tianxia": "Steppe",
        // 现代政权称呼(见 Locales/Cultures/README.md 政党一节)：未组建政府的势力 / 临时政府；没配的理念用默认称呼
        "Party": {
            "untitled_groups": {
                "Centrism": "UntitledCentrism",
                "Communism": "UntitledCommunism",
                "ReligiousDemocracy": "UntitledReligiousDemocracy",
                "Conservatism": "UntitledConservatism"
            }
        },
        "traits": ["patriarchy"],
        // 游牧(游牧扩张、牧帐、放牧加倍)、劫掠传统(派系可提劫掠)，见 Locales/Cultures/README.md
        "political_traits": ["nomad", "raider"],
        // 村镇(见 Locales/Cultures/README.md 村镇一节)：农耕的村镇照旧按姓氏起(某某村)；毡帐村镇(游牧营地的城立的)
        // 用游牧的字库与营、帐、艾里，波罗、大营这类尾字，同农耕村镇分得开
        "Settlement": {
            "yurt_village_modes": { "surname": 1, "words": 2 },
            "yurt_town_modes": { "words": 1 },
            "yurt_words": "YurtWords",
            "yurt_village_suffix": "YurtVillageSuffix",
            "yurt_town_suffix": "YurtTownSuffix"
        },
        "City": {
            "groups": {
                "group_1": "CityNames1"
            },
            "rule": [ "group_1", "group_2", "group_3", "group_4" ],
            "name_pos": 0
        },
        "Clan": {
            "groups": {
                "group_1": "ClanNames",
                "group_2": "\u200A",
                "group_3": "Clan"
            },
            "rule": [ "group_1", "group_2", "group_3" ],
            "name_pos": 0,
            "has_sex_post": false,
            "use_local_as_lastname": false,
            "sex_post_Male": ["", "", ""],
            "sex_post_Female": ["", "", ""]
        },
        "Family": {
