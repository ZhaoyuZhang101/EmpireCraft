{
    "name": "Kosher",
    "color": "#0038B8",
    "translate_cz": "犹太",
    "setting": {
        "regime": "Feudalism",
        "institution_line": "Roma",
        // 天下标识(用户 2026-10-21 定"补天下标识")：本文化自成一个天下；明写了，相邻的同文化帝国法理才会自动并成一个天下
        // (没写的一个帝国法理一个天下，常常凑不满 8 城、没有天命，见 TianxiaSystem.AutoArrange)
        "tianxia": "Kosher",
        // 现代政权称呼(见 Locales/Cultures/README.md 政党一节)：未组建政府的势力 / 临时政府；没配的理念用默认称呼
        "Party": {
            "untitled_groups": {
                "SocialDemocracy": "UntitledSocialDemocracy",
                "Socialism": "UntitledSocialism",
                "ReligiousDemocracy": "UntitledReligiousDemocracy",
                "Conservatism": "UntitledConservatism"
            }
        },
        "traits": ["patriarchy"],
        // 无人区命名(见 Locales/Cultures/README.md 无人区一节)：地名 + 类型后缀，圣经地名：黑门山、寻的旷野、以法莲树林、胡拉沼泽；冻原引用斯拉夫的
        "Wilderness": {
            "words": { "mountain": "WildMountain", "desert": "WildDesert", "tundra": "Slavonic:WildTundra", "jungle": "WildJungle", "swamp": "WildSwamp" },
            "suffix": { "mountain": "WildMountainSuffix", "desert": "WildDesertSuffix", "jungle": "WildJungleSuffix" }
        },
        "City": {
            "groups": {
                "group_1": "CityNames1",
                "group_2": "CityNames2"
            },
            "rule": [ "group_1", "group_2" ],
            "name_pos": 0
        },
        "Clan": {
            "groups": {
                "group_1": "ClanNames",
                "group_2": "Clan",
                "group_3": "\u200A"
            },
            "rule": [
                "group_1",
                "group_3",
                "group_2"
            ],
            "name_pos": 0,
            "has_sex_post": false,
            "use_local_as_lastname": false,
            "sex_post_Male": ["", "", ""],
            "sex_post_Female": ["", "", ""]
        },
        "Family": {
            "groups": {
                "group_1": "FamilyNames",
                "group_2": "Family",
                "group_3": "\u200A"
            },
            "rule": [ "group_1", "group_3", "group_2" ],
            "name_pos": 0,
            "has_sex_post": false,
            "use_local_as_lastname": false
        },
        "Unit": {
            "groups": {
                "group_1": "UnitNamesMale1",
                "group_2": "UnitNamesFemale1"
            },
            "rule": [
                "group_1",
                "sex_male",
                "group_2",
                "sex_female",
                "space"
            ],
            "name_pos": 0,
            "is_invert": true
        },
        "Kingdom": {
            "groups": {
                "group_1": "CountryNames"
            },
            "rule": [ "group_1" ],
            "name_pos": 0
        }
    },
    "beaurau_config": {
        "CoreOffice": [],
        "Divisions": []
    }
}
