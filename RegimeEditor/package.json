{
  "name": "empirecraft-regime-editor",
  "version": "0.3.0",
  "description": "EmpireCraft editors: regimes, cultures, tech and institution nodes, claim rules, military and misc configs.",
  "main": "main.js",
  "author": "Codex",
  "license": "MIT",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "dist": "node node_modules/electron-builder/cli.js --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.empirecraft.regimeeditor",
    "productName": "EmpireCraft Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "CustomRegimeTemplate/**/*",
      "RegimeTemplates/**/*",
      "assets/**/*",
      "claims.html",
      "common.css",
      "common.js",
      "culture.html",
      "editor-core.js",
      "index.html",
      "main.js",
      "military.html",
      "misc.html",
      "nodes.html",
      "package.json",
      "pixel-theme.css",
      "preload.js",
      "regime-enum-sync.js",
      "zh-convert.js"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
